---
import { Mail, Phone, MapPin, Send, CircleCheck } from 'lucide-astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
const { info, form } = t.contact;

const directItems = [
  { icon: Mail, label: info.email, value: 'export@cruisesindibad.com', href: 'mailto:export@cruisesindibad.com' },
  { icon: Phone, label: info.phone, value: '+20 100 000 0000', href: 'tel:+201000000000' },
  { icon: WhatsAppIcon, label: info.whatsapp, value: '+20 100 000 0000', href: 'https://wa.me/201000000000' },
];
---

<section id="contact" class="bg-white py-20 sm:py-28">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">{t.contact.eyebrow}</span>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl lg:text-5xl">{t.contact.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-700">{t.contact.lead}</p>
    </div>

    <!-- Primary: direct contact methods -->
    <ul class="mx-auto mt-12 grid max-w-5xl gap-4 sm:grid-cols-3 sm:gap-6">
      {
        directItems.map(({ icon: Icon, label, value, href }) => (
          <li>
            <a
              href={href}
              class="group flex h-full flex-col items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 p-6 text-center transition hover:border-navy-700 hover:bg-white hover:shadow-md sm:p-8"
            >
              <span class="grid size-14 place-items-center rounded-full bg-navy-900 text-white">
                <Icon size={26} />
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-700">{label}</span>
              <span class="max-w-full break-words text-lg font-bold text-ink group-hover:underline sm:text-xl">
                <bdi dir="ltr">{value}</bdi>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 flex items-center justify-center gap-2 text-center text-slate-700">
      <MapPin size={18} class="shrink-0" />
      <span><span class="font-semibold">{info.office}:</span> {info.officeValue}</span>
    </p>

    <!-- Secondary: written inquiry -->
    <div class="mx-auto mt-16 max-w-3xl">
      <h3 class="mb-5 flex items-center gap-4 text-lg font-bold text-slate-800">
        <span class="h-px flex-1 bg-slate-200"></span>
        <span class="text-center">{form.heading}</span>
        <span class="h-px flex-1 bg-slate-200"></span>
      </h3>
      
      <!-- ZDE JE ZMĚNA: Přidaný action, method a Web3Forms parametry -->
      <form 
        id="inquiry-form" 
        action="https://api.web3forms.com/submit" 
        method="POST" 
        class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8" 
        novalidate
      >
          <input type="hidden" name="access_key" value="43226da0-dd75-4a01-9fb1-2fadf23aaa0e" />

          <input type="hidden" name="subject" value="Nová poptávka z formuláře" />

          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.name}</span>
              <input name="name" type="text" required autocomplete="name" class="field" placeholder={form.namePlaceholder} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.company}</span>
              <input name="company" type="text" required autocomplete="organization" class="field" placeholder={form.companyPlaceholder} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.email}</span>
              <input name="email" type="email" required autocomplete="email" dir="ltr" class="field rtl:text-end" placeholder={form.emailPlaceholder} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.country}</span>
              <input name="country" type="text" required autocomplete="country-name" class="field" placeholder={form.countryPlaceholder} />
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.volume}</span>
              <select name="volume" class="field">
                {form.volumeOptions.map((o) => <option>{o}</option>)}
              </select>
            </label>
            <label class="block sm:col-span-2">
              <span class="mb-1.5 block text-sm font-medium text-slate-700">{form.message}</span>
              <textarea name="message" rows="5" required class="field resize-y" placeholder={form.messagePlaceholder}></textarea>
            </label>
          </div>

          <p id="form-error" class="mt-4 hidden text-sm font-medium text-red-600" role="alert">{form.error}</p>

          <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-700">{form.privacy}</p>
            <button type="submit" class="btn-primary shrink-0 px-6">
              {form.submit} <Send size={16} class="rtl:-scale-x-100" />
            </button>
          </div>

          <div id="form-success" class="mt-6 hidden items-center gap-3 rounded-md border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-ink" role="status">
            <CircleCheck size={18} class="shrink-0 text-leaf-600" /> {form.success}
          </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const error = document.getElementById('form-error')!;
  const success = document.getElementById('form-success')!;

  form.addEventListener('submit', async (e) => {
    // 1. Vždy zastavíme výchozí odeslání prohlížeče
    e.preventDefault();

    // 2. Kontrola validace poli
    if (!form.checkValidity()) {
      error.textContent = 'Prosím vyplňte všechna povinná pole.';
      error.classList.remove('hidden');
      form.reportValidity();
      return;
    }

    error.classList.add('hidden');
    
    // Získání dat z formuláře
    const formData = new FormData(form);

    try {
      // 3. Odeslání přímo přes POST v JavaScriptu
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        // Zobrazení zelené hlášky o úspěchu
        success.classList.remove('hidden');
        success.classList.add('flex');
        form.reset();
      } else {
        // Zobrazení chyby, pokud Web3Forms vráti error
        error.textContent = data.message || 'Chyba při odesílání formuláře.';
        error.classList.remove('hidden');
      }
    } catch (err) {
      error.textContent = 'Nepodařilo se připojit k serveru. Zkontrolujte připojení.';
      error.classList.remove('hidden');
    }
  });
</script>