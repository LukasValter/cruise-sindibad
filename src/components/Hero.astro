---
import { ArrowRight, Sprout, Snowflake, Package, Ship, ShieldCheck, Globe } from 'lucide-astro';
import { getLang, useTranslations } from '../i18n/utils';
import { products } from '../data/products';

const t = useTranslations(getLang(Astro.currentLocale));
const { points } = t.hero;

const strip = [
  { icon: Snowflake, ...points.cold },
  { icon: Package, ...points.packaging },
  { icon: Ship, ...points.fcl },
  { icon: ShieldCheck, ...points.quality },
  { icon: Globe, ...points.markets },
];

// Placeholder product photography — reuses the catalogue stock photos.
const photo = (id: keyof typeof t.products.items) => ({
  src: products.find((p) => p.id === id)!.image,
  alt: t.products.items[id].name,
});
const photos = [photo('strawberries'), photo('peas'), photo('mango'), photo('mixed')];
---

<section id="hero" class="border-b border-slate-200 bg-white pt-32 pb-16 sm:pt-40 sm:pb-20">
  <div class="container-x">
    <span class="eyebrow"><Sprout size={14} /> {t.hero.eyebrow}</span>

    <!-- Both columns stretch to the same height: the headline's top edge and the CTA row's bottom edge
         define it, and the photo grid fills exactly that box. -->
    <div class="mt-6 grid gap-12 md:grid-cols-12 md:gap-10 lg:gap-14">
      <div class="min-w-0 md:col-span-7">
        <h1 class="text-4xl font-bold leading-[1.1] sm:text-5xl md:text-4xl lg:text-5xl xl:text-6xl">
          {t.hero.titleBefore} {t.hero.titleHighlight} {t.hero.titleAfter}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-700">{t.hero.lead}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="#contact" class="btn-primary px-6 py-3.5 text-base">
            {t.hero.ctaPrimary} <ArrowRight size={18} class="rtl:-scale-x-100" />
          </a>
          <a href="#products" class="btn-secondary px-6 py-3.5 text-base">{t.hero.ctaSecondary}</a>
        </div>
      </div>

      <div class="hidden min-w-0 md:col-span-5 md:flex md:items-center md:justify-end">
        <div class="grid aspect-square w-full max-w-md grid-cols-2 grid-rows-2 gap-3">
          {
            photos.map(({ src, alt }) => (
              <div class="min-h-0 overflow-hidden rounded-2xl bg-slate-100 p-3 shadow-md shadow-slate-900/10 lg:p-4">
                <img
                  src={src}
                  alt={alt}
                  width="600"
                  height="600"
                  decoding="async"
                  onerror="this.style.display='none'"
                  class="size-full object-contain mix-blend-multiply"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-5 xl:gap-8">
          {
            strip.map(({ icon: Icon, title, text }) => (
              <li class="flex items-start gap-3.5">
                <div class="shrink-0 pt-0.5">
                  <Icon size={22} strokeWidth={1.75} class="text-ink" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold sm:text-base leading-tight">{title}</h3>
                  <p class="mt-1 text-xs sm:text-sm leading-relaxed text-slate-700">{text}</p>
                </div>
              </li>
            ))
          }
        </ul>
  </div>
</section>
