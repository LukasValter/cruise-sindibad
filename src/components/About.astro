---
import { Snowflake, Sprout, Ship, Sun, Droplets, Clock, CircleCheck } from 'lucide-astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
const { pillars, points } = t.about;

const pillarItems = [
  { icon: Snowflake, ...pillars.iqf },
  { icon: Sprout, ...pillars.farms },
  { icon: Ship, ...pillars.export },
];

const pointItems = [
  { icon: Sun, text: points.harvest },
  { icon: Droplets, text: points.residue },
  { icon: Clock, text: points.speed },
];
---

<section id="about" class="bg-slate-50 py-20 sm:py-28">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-end">
      <div>
        <span class="eyebrow">{t.about.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold sm:text-4xl lg:text-5xl">{t.about.title}</h2>
      </div>
      <p class="text-lg leading-relaxed text-slate-700">{t.about.lead}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pillarItems.map(({ icon: Icon, title, text }) => (
          <article class="card group p-8 transition hover:border-slate-400">
            <span class="grid size-12 place-items-center rounded-md bg-slate-100 text-ink transition group-hover:bg-navy-900 group-hover:text-white">
              <Icon size={24} />
            </span>
            <h3 class="mt-6 text-xl font-bold">{title}</h3>
            <p class="mt-3 leading-relaxed text-slate-700">{text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-4 rounded-lg border border-slate-200 bg-white px-8 py-6 lg:flex-row lg:items-center lg:justify-between">
      <p class="flex items-center gap-2 font-semibold text-ink">
        <CircleCheck size={20} class="text-ink" /> {t.about.whyTitle}
      </p>
      <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-x-8">
        {
          pointItems.map(({ icon: Icon, text }) => (
            <li class="flex items-center gap-2 text-sm font-medium text-slate-700">
              <Icon size={18} class="text-slate-700" /> {text}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
