---
import { Snowflake, Sprout, Ship } from 'lucide-astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
const { pillars } = t.about;

const pillarItems = [
  { icon: Snowflake, ...pillars.iqf },
  { icon: Sprout, ...pillars.farms },
  { icon: Ship, ...pillars.export },
];
---

<section id="about" class="bg-slate-50 py-20 sm:py-28">
  <div class="container-x">
    <!-- Opravené zarovnání: items-start namísto items-end -->
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <span class="eyebrow">{t.about.eyebrow}</span>
        <h2 class="mt-5 text-3xl font-bold sm:text-4xl lg:text-5xl">{t.about.title}</h2>
      </div>
      <!-- Přidán jemný horní padding lg:pt-2 pro optické srovnání s nadpisem -->
      <p class="text-lg leading-relaxed text-slate-700 lg:pt-2">{t.about.lead}</p>
    </div>

    <!-- 3 hlavní pilíře (karty) -->
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pillarItems.map(({ icon: Icon, title, text }) => (
          <article class="card group p-8 transition hover:border-slate-400">
            <span class="grid size-12 place-items-center rounded-md bg-slate-100 text-ink transition group-hover:bg-navy-900 group-hover:text-white">
              <Icon size={24} />
            </span>
            <h3 class="mt-6 text-xl font-bold">{title}</h3>
            <p class="mt-3 leading-relaxed text-slate-700">{text}</p>
          </article>
        ))
      }
    </div>

    <!-- Spodní box s pointItems byl kompletně odstraněn -->
  </div>
</section>