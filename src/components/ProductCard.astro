---
import { Images, Video, Leaf } from 'lucide-astro';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  id: string;
  name: string;
  variants: string[];
  image: string;
  gallery?: string[];
  videos?: unknown[];
  inSeason?: boolean;
}

const { id, name, variants, image, gallery, videos, inSeason } = Astro.props;
const { specs, inSeasonBadge } = useTranslations(getLang(Astro.currentLocale)).products;
---

<article class="card group overflow-hidden transition hover:border-slate-400">
  <div class="relative aspect-square overflow-hidden bg-slate-100 p-4 sm:p-6">
    {
      inSeason && (
        <span class="absolute start-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-full bg-leaf-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow">
          <Leaf size={14} aria-hidden="true" /> {inSeasonBadge}
        </span>
      )
    }
    {
      (gallery?.length || videos?.length) && (
        <span
          title={specs.supplierMedia}
          class="absolute end-3 top-3 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-2 py-1 text-xs font-semibold text-slate-800 shadow-sm"
        >
          <span class="sr-only">{specs.supplierMedia}</span>
          {gallery?.length ? <Images size={14} aria-hidden="true" /> : null}
          {gallery?.length ? <span aria-hidden="true">{gallery.length + 1}</span> : null}
          {videos?.length ? <Video size={14} aria-hidden="true" /> : null}
        </span>
      )
    }
    <img
      src={image}
      alt={name}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
      class="relative size-full object-contain mix-blend-multiply"
    />
  </div>
  <div class="p-5">
    <h4 class="text-lg font-bold">{name}</h4>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {variants.map((v) => <li class="rounded-sm bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800">{v}</li>)}
    </ul>
    <button type="button" data-open-dialog={`product-${id}`} class="btn-secondary mt-5 w-full px-4 py-2.5">
      {specs.view}
    </button>
  </div>
</article>
