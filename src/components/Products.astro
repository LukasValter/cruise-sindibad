---
import { Snowflake, X, Check, ArrowRight, Play, Leaf } from 'lucide-astro';
import ProductCard from './ProductCard.astro';
import { getLang, useTranslations } from '../i18n/utils';
import { products } from '../data/products';

const t = useTranslations(getLang(Astro.currentLocale));
const { items, specs } = t.products;
const specGroups = [specs.bulk, specs.retail, specs.shipping];

const fmt = (n: number) => n.toLocaleString(getLang(Astro.currentLocale), { minimumFractionDigits: 0, maximumFractionDigits: 1 });
const nutritionRows = (n: { kcal: number; fat: number; carbs: number; sugars: number; fibre: number; protein: number; salt: number }) => [
  { label: specs.energy, value: `${Math.round(n.kcal * 4.184)} kJ / ${n.kcal} kcal`, strong: true },
  { label: specs.fat, value: `${fmt(n.fat)} g` },
  { label: specs.carbs, value: `${fmt(n.carbs)} g` },
  { label: specs.sugars, value: `${fmt(n.sugars)} g`, sub: true },
  { label: specs.fibre, value: `${fmt(n.fibre)} g` },
  { label: specs.protein, value: `${fmt(n.protein)} g` },
  { label: specs.salt, value: `${fmt(n.salt)} g` },
];

const withText = (p: (typeof products)[number]) => ({ ...p, ...items[p.id] });

// Products flagged `inSeason` are featured first; their dialogs come from the category groups below.
const seasonal = products.filter((p) => p.inSeason).map(withText);

const groups = [
  { key: 'fruits', title: t.products.fruits, cols: 'sm:grid-cols-2 lg:grid-cols-3' },
  { key: 'vegetables', title: t.products.vegetables, cols: 'sm:grid-cols-2 lg:grid-cols-4' },
].map((g) => ({
  ...g,
  products: products.filter((p) => p.category === g.key).map(withText),
}));
---

<section id="products" class="bg-white py-20 sm:py-28">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><Snowflake size={14} /> {t.products.eyebrow}</span>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl lg:text-5xl">{t.products.title}</h2>
      <p class="mt-5 text-lg text-slate-700">{t.products.lead}</p>
    </div>

    <div class="mt-16 space-y-16">
      {
        seasonal.length > 0 && (
          <div id="in-season" class="rounded-lg border border-leaf-600/30 bg-leaf-600/5 p-5 sm:p-8">
            <h3 class="flex items-center gap-2 text-xl font-bold">
              <Leaf size={22} class="text-leaf-600" aria-hidden="true" />
              {t.products.inSeason}
            </h3>
            <p class="mt-2 max-w-2xl text-slate-700">{t.products.inSeasonLead}</p>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {seasonal.map((product) => <ProductCard {...product} />)}
            </div>
          </div>
        )
      }
      {
        groups.map(({ title, cols, products }) => (
          <div>
            <h3 class="mb-6 flex items-center gap-3 text-lg font-bold">
              {title}
              <span class="h-px flex-1 bg-slate-200" />
            </h3>
            <div class:list={['grid gap-6', cols]}>
              {products.map((product) => <ProductCard {...product} />)}
            </div>
          </div>
        ))
      }
    </div>

    {
      groups.flatMap((g) => g.products).map(({ id, name, variants, image, gallery, videos, nutrition }) => (
        <dialog
          id={`product-${id}`}
          aria-labelledby={`product-${id}-title`}
          class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-lg bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/60 backdrop:backdrop-blur-sm"
        >
          <form method="dialog" class="absolute end-3 top-3 z-10">
            <button type="submit" aria-label={specs.close} class="grid size-10 place-items-center rounded-full bg-white/90 text-ink shadow transition hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-ink">
              <X size={20} />
            </button>
          </form>
          <div class="grid sm:grid-cols-5">
            <div data-gallery class="flex flex-col justify-center gap-3 bg-slate-100 p-6 sm:col-span-2">
              <div class="relative aspect-square">
                <img data-main-image src={image} alt={name} width="600" height="600" loading="lazy" decoding="async" class="size-full object-contain mix-blend-multiply" />
                {videos?.length ? (
                  <video data-main-video controls preload="none" playsinline hidden class="size-full rounded bg-black object-contain" />
                ) : null}
              </div>
              {(gallery?.length || videos?.length) && (
                <ul class="flex flex-wrap gap-2">
                  {[image, ...(gallery ?? [])].map((src, i) => (
                    <li>
                      <button
                        type="button"
                        data-thumb
                        data-src={src}
                        aria-label={`${specs.showMedia} ${i + 1}`}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                        class="block size-14 overflow-hidden rounded border-2 border-transparent bg-white p-0.5 transition aria-pressed:border-leaf-600"
                      >
                        <img src={src} alt="" width="56" height="56" loading="lazy" decoding="async" class="size-full object-contain" />
                      </button>
                    </li>
                  ))}
                  {videos?.map((v, i) => (
                    <li>
                      <button
                        type="button"
                        data-thumb
                        data-video-src={v.src}
                        data-poster={v.poster}
                        aria-label={`${specs.video} ${i + 1}`}
                        aria-pressed="false"
                        class="relative block size-14 overflow-hidden rounded border-2 border-transparent bg-ink transition aria-pressed:border-leaf-600"
                      >
                        {v.poster && <img src={v.poster} alt="" width="56" height="56" loading="lazy" decoding="async" class="size-full object-cover opacity-70" />}
                        <Play size={20} aria-hidden="true" class="absolute inset-0 m-auto text-white" />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class="p-6 sm:col-span-3 sm:p-8">
              <h3 id={`product-${id}-title`} class="pe-10 text-2xl font-bold">{name}</h3>
              <div role="tablist" class="mt-5 flex gap-1 rounded-md bg-slate-100 p-1 text-sm font-semibold">
                <button type="button" role="tab" id={`product-${id}-tab-specs`} aria-controls={`product-${id}-panel-specs`} aria-selected="true" data-tab="specs" class="flex-1 rounded px-3 py-1.5 text-slate-700 transition aria-selected:bg-white aria-selected:text-ink aria-selected:shadow-sm">
                  {specs.tabSpecs}
                </button>
                <button type="button" role="tab" id={`product-${id}-tab-nutrition`} aria-controls={`product-${id}-panel-nutrition`} aria-selected="false" tabindex="-1" data-tab="nutrition" class="flex-1 rounded px-3 py-1.5 text-slate-700 transition aria-selected:bg-white aria-selected:text-ink aria-selected:shadow-sm">
                  {specs.tabNutrition}
                </button>
              </div>

              <div role="tabpanel" id={`product-${id}-panel-specs`} aria-labelledby={`product-${id}-tab-specs`} data-panel="specs" class="mt-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-700">{specs.forms}</p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {variants.map((v) => (
                    <li class="rounded-sm bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800">{v}</li>
                  ))}
                </ul>
                <div class="mt-6 space-y-5">
                  {specGroups.map(({ title, items }) => (
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wider text-slate-700">{title}</p>
                      <ul class="mt-2 space-y-1.5">
                        {items.map((item) => (
                          <li class="flex gap-2.5 text-sm leading-snug">
                            <Check size={16} class="mt-0.5 shrink-0 text-leaf-600" /> {item}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>

              <div role="tabpanel" id={`product-${id}-panel-nutrition`} aria-labelledby={`product-${id}-tab-nutrition`} data-panel="nutrition" hidden class="mt-6">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-700">{specs.tabNutrition} · {specs.per100}</p>
                <dl class="mt-2 text-sm">
                  {nutritionRows(nutrition).map(({ label, value, strong, sub }) => (
                    <div class:list={['flex justify-between gap-4 border-b border-slate-200 py-2', sub && 'ps-4 text-slate-700']}>
                      <dt class:list={[strong && 'font-semibold']}>{label}</dt>
                      <dd class:list={['text-end tabular-nums', strong && 'font-semibold']}>
                        <bdi dir="ltr">{value}</bdi>
                      </dd>
                    </div>
                  ))}
                </dl>
                <p class="mt-3 text-xs leading-relaxed text-slate-700">{specs.note}</p>
              </div>
              <a href="#contact" data-close-dialog class="btn-primary mt-7 w-full">
                {specs.quote} <ArrowRight size={16} class="rtl:-scale-x-100" />
              </a>
            </div>
          </div>
        </dialog>
      ))
    }
  </div>
</section>

<script>
  // Native <dialog>: Esc and focus handling come for free; we add backdrop-click close and scroll lock.
  const lock = (on: boolean) => document.documentElement.classList.toggle('overflow-hidden', on);

  document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dlg = document.getElementById(btn.dataset.openDialog!) as HTMLDialogElement | null;
      if (!dlg) return;
      dlg.showModal();
      lock(true);
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog[id^="product-"]').forEach((dlg) => {
    // Content fills the dialog (p-0), so a click whose target is the dialog itself hit the backdrop.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => {
      lock(false);
      select('specs'); // always reopen on the packaging view
      showMedia(thumbs[0] ?? null);
    });

    // Gallery: thumbnails swap the main image; the video thumbnail swaps in the player.
    const mainImg = dlg.querySelector<HTMLImageElement>('[data-main-image]');
    const mainVideo = dlg.querySelector<HTMLVideoElement>('[data-main-video]');
    const thumbs = [...dlg.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    function showMedia(thumb: HTMLButtonElement | null) {
      if (!mainImg) return;
      const videoSrc = thumb?.dataset.videoSrc;
      if (thumb && !videoSrc) mainImg.src = thumb.dataset.src!;
      mainImg.hidden = !!videoSrc;
      if (mainVideo) {
        mainVideo.pause();
        mainVideo.hidden = !videoSrc;
        if (videoSrc && !mainVideo.src.endsWith(videoSrc)) {
          mainVideo.poster = thumb!.dataset.poster ?? '';
          mainVideo.src = videoSrc;
        }
      }
      thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
    }
    thumbs.forEach((t) => t.addEventListener('click', () => showMedia(t)));

    const tabs = dlg.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const panels = dlg.querySelectorAll<HTMLElement>('[data-panel]');
    function select(name: string) {
      tabs.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        next.focus();
        select(next.dataset.tab!);
      });
    });
    dlg.querySelector('[data-close-dialog]')?.addEventListener('click', () => dlg.close());
  });
</script>
