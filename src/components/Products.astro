---
import { Snowflake, ArrowRight, Check } from 'lucide-astro';
import { getLang, useTranslations } from '../i18n/utils';
import { products } from '../data/products';

const t = useTranslations(getLang(Astro.currentLocale));
const { items, packaging } = t.products;

const groups = [
  { key: 'fruits', title: t.products.fruits, cols: 'sm:grid-cols-2 lg:grid-cols-3' },
  { key: 'vegetables', title: t.products.vegetables, cols: 'sm:grid-cols-2 lg:grid-cols-4' },
].map((g) => ({
  ...g,
  products: products.filter((p) => p.category === g.key).map((p) => ({ ...p, ...items[p.id] })),
}));

const packagingGroups = [packaging.bulk, packaging.retail, packaging.shipping];
---

<section id="products" class="bg-white py-20 sm:py-28">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow"><Snowflake size={14} /> {t.products.eyebrow}</span>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl lg:text-5xl">{t.products.title}</h2>
      <p class="mt-5 text-lg text-slate-700">{t.products.lead}</p>
    </div>

    <div class="mt-16 space-y-16">
      {
        groups.map(({ title, cols, products }) => (
          <div>
            <h3 class="mb-6 flex items-center gap-3 text-lg font-bold">
              {title}
              <span class="h-px flex-1 bg-slate-200" />
            </h3>
            <div class:list={['grid gap-6', cols]}>
              {products.map(({ name, variants, image }) => (
                <article class="card group overflow-hidden transition hover:border-slate-400">
                  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
                    <Snowflake size={32} class="absolute inset-0 m-auto text-slate-300" />
                    <img
                      src={image}
                      alt={name}
                      width="800"
                      height="600"
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none'"
                      class="relative size-full object-cover"
                    />
                  </div>
                  <div class="p-5">
                    <h4 class="text-lg font-bold">{name}</h4>
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                      {variants.map((v) => (
                        <li class="rounded-sm bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-800">{v}</li>
                      ))}
                    </ul>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-20 rounded-lg bg-navy-900 p-8 text-white sm:p-10">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <h3 class="text-2xl font-bold text-white">{packaging.title}</h3>
          <p class="mt-3 leading-relaxed text-slate-300">{packaging.lead}</p>
          <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white underline underline-offset-4 hover:text-slate-300">
            {packaging.cta} <ArrowRight size={16} class="rtl:-scale-x-100" />
          </a>
        </div>
        <div class="grid gap-8 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-white/10 lg:col-span-8">
          {
            packagingGroups.map(({ title, items }) => (
              <div class="sm:px-6 sm:first:ps-0 sm:last:pe-0">
                <p class="text-sm font-semibold uppercase tracking-wider text-slate-300">{title}</p>
                <ul class="mt-4 space-y-3">
                  {items.map((item) => (
                    <li class="flex gap-2.5 text-sm leading-snug text-white">
                      <Check size={16} class="mt-0.5 shrink-0 text-slate-400" /> {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
